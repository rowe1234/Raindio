#version 450

// ============================================================================
// Raindio Native Vulkan Compute Shader — Pass 2: Trimmed-Mean Exposure Adaptation
//   - Reads 256-bin luminance histogram SSBO and clears bins to 0 for next frame
//   - Stores persistent adaptedExp state directly inside the SSBO (avoids read_write
//     rgba16f storage image quirks on Apple Silicon MoltenVK; uAdaptImg is writeonly)
//   - Computes trimmed weighted mean luminance (drops darkest 12% & brightest 4%)
//   - Smoothly adapts exposure with cinematic asymmetric eye-adaptation rates
//     (dark->bright: 1.6/s, bright->dark: 0.75/s) over [0.32, 3.80]
// ============================================================================

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform AdaptPush {
    float dt;         // Frame delta seconds clamped to [0.001, 0.1]
    int resetFlag;    // 1 on first frame or world/dimension switch -> reset to INIT_EXP
    float keyValue;   // Middle-gray target key value (~0.22)
    float pad0;
} uPush;

layout(set = 0, binding = 0, std430) buffer HistogramBuffer {
    uint bins[256];
    float adaptedExp;
    float avgLum;
    float targetExp;
    float initialized;
} gHist;

layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D uAdaptImg;

shared uint sBins[256];

const float MIN_LOG_LUM = -9.0;
const float LOG_RANGE   = 13.0; // [-9.0, +4.0]
const float MIN_EXP     = 0.32;
const float MAX_EXP     = 2.25;
const float INIT_EXP    = 1.00;

void main() {
    uint lid = gl_LocalInvocationIndex;

    // 1. Copy histogram bin to shared memory and clear SSBO bin to 0 for next frame
    sBins[lid] = gHist.bins[lid];
    gHist.bins[lid] = 0u;
    memoryBarrierShared();
    barrier();

    if (lid != 0u) return;

    // 2. Compute total weighted sample count across all 256 bins
    float totalWeight = 0.0;
    for (uint i = 0u; i < 256u; i++) {
        totalWeight += float(sBins[i]);
    }

    bool doReset = (uPush.resetFlag != 0) || (gHist.initialized < 0.5);
    float prevExp = doReset ? INIT_EXP : gHist.adaptedExp;
    if (isnan(prevExp) || isinf(prevExp) || prevExp < 0.05 || prevExp > 10.0) {
        prevExp = INIT_EXP;
    }

    if (totalWeight < 1.0) {
        gHist.adaptedExp = prevExp;
        gHist.avgLum = 0.22;
        gHist.targetExp = prevExp;
        gHist.initialized = 1.0;
        imageStore(uAdaptImg, ivec2(0, 0), vec4(prevExp, 0.22, prevExp, 1.0));
        return;
    }

    // 3. Trimmed weighted mean: discard darkest 12% and only brightest 4% specular fireflies
    float lowCut  = totalWeight * 0.12;
    float highCut = totalWeight * 0.96;

    float cumWeight = 0.0;
    float trimmedWeight = 0.0;
    float weightedLogSum = 0.0;

    for (uint i = 0u; i < 256u; i++) {
        float w = float(sBins[i]);
        if (w <= 0.0) continue;

        float segStart = cumWeight;
        float segEnd = cumWeight + w;
        cumWeight = segEnd;

        float overlapStart = max(segStart, lowCut);
        float overlapEnd   = min(segEnd, highCut);
        float keepW = max(0.0, overlapEnd - overlapStart);

        if (keepW > 0.0) {
            float binLogLum = (i == 0u)
                ? MIN_LOG_LUM
                : (MIN_LOG_LUM + ((float(i) - 0.5) / 254.0) * LOG_RANGE);
            weightedLogSum += binLogLum * keepW;
            trimmedWeight += keepW;
        }
    }

    float avgLogLum = (trimmedWeight > 1e-3) ? (weightedLogSum / trimmedWeight) : -2.2;
    float avgLum = exp2(avgLogLum);
    float targetExp = clamp(uPush.keyValue / max(avgLum, 1e-4), MIN_EXP, MAX_EXP);

    // 4. Cinematic asymmetric eye adaptation:
    //    - Stepping into bright light (targetExp < prevExp): 1.6/s (~1.2s dazzle settle)
    //    - Stepping into dark cave (targetExp > prevExp):    0.75/s (~2.5s pupil dilation)
    float newExp;
    if (doReset) {
        newExp = targetExp;
    } else {
        float speed = (targetExp < prevExp) ? 1.6 : 0.75;
        float alpha = 1.0 - exp(-clamp(uPush.dt, 0.001, 0.1) * speed);
        newExp = prevExp + (targetExp - prevExp) * alpha;
    }

    newExp = clamp(newExp, MIN_EXP, MAX_EXP);
    gHist.adaptedExp = newExp;
    gHist.avgLum = avgLum;
    gHist.targetExp = targetExp;
    gHist.initialized = 1.0;

    imageStore(uAdaptImg, ivec2(0, 0), vec4(newExp, avgLum, targetExp, 1.0));
}
