#version 450

// ============================================================================
// Raindio Native Vulkan Compute Shader — Pass 1: Center-Weighted Log2 Luminance Histogram
//   - Scans composite3 HDR output (colortex0Scratch) at 2x2 stride (4x lower M1 bandwidth)
//   - Maps log2(lum) in [-9.0, +4.0] (13 EV) into 256 bins (bin 0 = very dark pixels)
//   - Strong center-weighted fovea metering (center = 8, edges = 1) so looking out a
//     bright window/cave exit or into a dark doorway drives crisp eye adaptation
//   - Accumulates in workgroup shared sHist[256], then 1 atomicAdd per bin to global SSBO
// ============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uHdrScene;

layout(set = 0, binding = 1, std430) buffer HistogramBuffer {
    uint bins[256];
    float adaptedExp;
    float avgLum;
    float targetExp;
    float initialized;
} gHist;

shared uint sHist[256];

const float MIN_LOG_LUM = -9.0;
const float MAX_LOG_LUM =  4.0;
const float INV_LOG_RANGE = 1.0 / (MAX_LOG_LUM - MIN_LOG_LUM);

void main() {
    uint lid = gl_LocalInvocationIndex;
    sHist[lid] = 0u;
    memoryBarrierShared();
    memoryBarrierShared();
    barrier();

    ivec2 texSize = textureSize(uHdrScene, 0);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) * 2;

    if (pixel.x < texSize.x && pixel.y < texSize.y) {
        vec3 hdr = texelFetch(uHdrScene, pixel, 0).rgb;
        if (!any(isnan(hdr)) && !any(isinf(hdr))) {
            float lum = dot(max(hdr, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));

            uint binIdx = 0u;
            if (lum >= 0.001953125) { // 2^-9
                float logLum = clamp((log2(lum) - MIN_LOG_LUM) * INV_LOG_RANGE, 0.0, 1.0);
                binIdx = clamp(uint(floor(logLum * 254.0 + 1.0)), 1u, 255u);
            }

            // Strong center-weighted fovea metering: center weight 8, screen edges weight 1
            vec2 uv = (vec2(pixel) + 0.5) / vec2(max(texSize, ivec2(1)));
            vec2 centered = (uv - 0.5) * 2.0;
            float distSq = dot(centered, centered);
            uint weight = uint(clamp(round(mix(8.0, 1.0, smoothstep(0.0, 0.95, distSq))), 1.0, 8.0));

            atomicAdd(sHist[binIdx], weight);
        }
    }

    memoryBarrierShared();
    memoryBarrierShared();
    barrier();

    uint localCount = sHist[lid];
    if (localCount > 0u) {
        atomicAdd(gHist.bins[lid], localCount);
    }
}
